#!/bin/sh

TAG="h5000m-fancontrol"
STATE_FILE="/var/run/h5000m-fancontrol.state"
POLICY_FILE="/var/run/h5000m-fancontrol.policy"
LOCK_DIR="/var/lock/h5000m-fancontrol.lock"
# 模块温度缓存的路径。
# ★ 必须落在本插件自己的命名空间里：这个文件既是写目标、也是 auto 模式下的读来源，
#   若沿用旧路径 /var/run/mt5700m/（那是被本机型构建明确排除的 luci-app-mt5700m
#   的命名空间），就可能读到**别的模组管理软件**写进去的数值 —— 那就不再是
#   「经 MT5700 Console 取到的温度」了。5G 模块数据只有这一条来源。
# 兼容：老环境变量名 H5000M_FAN_MT5700M_TEMP_CACHE 仍然承认（旧测试脚本在用）。
MT5700M_TEMP_CACHE="${H5000M_FAN_TEMP_CACHE:-${H5000M_FAN_MT5700M_TEMP_CACHE:-/var/run/h5000m-fancontrol.temperature}}"
MT5700M_TEMP_MAX_AGE="${H5000M_FAN_MT5700M_TEMP_MAX_AGE:-60}"
# 5G 模块温度的第二条通道（见 find_module_temp）：经 ubus 问 MT5700 Console 的
# Rust 后端（at-webserver-rust）要 AT^CHIPTEMP?。只在这条链路整体不可用时才
# 退回"只读缓存"，因此默认值必须保守 —— AT 查询是有代价的，不能每轮都打。
MODULE_TEMP_UBUS_TIMEOUT="${H5000M_FAN_MODULE_TEMP_UBUS_TIMEOUT:-8}"

is_uint() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

clamp() {
	local value="$1" min="$2" max="$3"
	[ "$value" -lt "$min" ] && value="$min"
	[ "$value" -gt "$max" ] && value="$max"
	echo "$value"
}

# UCI 读取统一从这里走。
#
# 优先用 /lib/functions.sh 的纯 shell 解析：`uci -q get` 每读一个选项就要 fork 一次，
# 而 load_config 要读 17 个选项、守护进程每轮还要调用两次 —— 实测这 34 次 fork
# 占整轮外部进程的 1/4。config_load / config_get 是同一份 UCI 数据的本地解析，
# 零外部进程。
#
# 真机实测（H5000M，busybox 1.38）：18 个选项两边取值逐项一致，缺项都返回空串；
# config_load 可在同一进程内反复调用而不累积（CONFIG_SECTIONS 保持 [settings]）。
#
# 非 OpenWrt 环境（例如 CI 里的单元测试）没有这个文件，退回 uci 命令行 —— 那种环境下
# 连 uci 也没有，两条路都返回空串、由调用方回落到默认值，行为与改动前一致。
CFG_NAME="h5000m_fancontrol"
CFG_SECTION="settings"
if [ -r /lib/functions.sh ]; then
	. /lib/functions.sh
	cfg_load() { config_load "$CFG_NAME"; }
	cfg_raw() {
		local value
		config_get value "$CFG_SECTION" "$1"
		printf '%s\n' "$value"
	}
else
	cfg_load() { :; }
	cfg_raw() { uci -q get "${CFG_NAME}.${CFG_SECTION}.$1" 2>/dev/null || true; }
fi

cfg_uint() {
	local option="$1" fallback="$2" min="$3" max="$4" value
	value="$(cfg_raw "$option")"
	is_uint "$value" || value="$fallback"
	clamp "$value" "$min" "$max"
}

cfg_string() {
	local option="$1" fallback="$2" value
	value="$(cfg_raw "$option")"
	[ -n "$value" ] || value="$fallback"
	echo "$value"
}

load_config() {
	# config_get 读的是上一句装载进来的 shell 变量；$( ) 子 shell 会继承它们，
	# 因此这里只装一次，17 次读取都不再产生进程。
	cfg_load
	ENABLED="$(cfg_uint enabled 1 0 1)"
	MODE="$(cfg_string mode auto)"
	case "$MODE" in auto|manual|kernel) ;; off) MODE="kernel" ;; *) MODE="auto" ;; esac
	PROFILE="$(cfg_string curve balanced)"
	case "$PROFILE" in silent|balanced|performance|custom) ;; *) PROFILE="balanced" ;; esac
	TEMP_SOURCE="$(cfg_string temp_source max)"
	case "$TEMP_SOURCE" in max|cpu) ;; *) TEMP_SOURCE="max" ;; esac
	# 5G 模块温度的取法（只有 MT5700 Console 这一条来源）：
	#   auto  = 新鲜缓存 → ubus 问 MT5700 Console → 未过上限的旧缓存
	#   cache = 只用本插件缓存（完全不碰 AT 通道）
	#   ubus  = 只走 ubus（仍会写缓存，但不读缓存）
	#   off   = 不取模块温度（模块不参与 max 取热）
	# 环境变量优先于 UCI，便于离线测试注入。
	MODULE_TEMP_SOURCE="$(cfg_string module_temp_source "${H5000M_FAN_MODULE_TEMP_SOURCE:-auto}")"
	case "$MODULE_TEMP_SOURCE" in auto|cache|ubus|off) ;; *) MODULE_TEMP_SOURCE="auto" ;; esac
	# 两次 AT^CHIPTEMP? 之间的最小间隔（默认 30s，与 MT5700 Console 前端慢档一致）。
	# 风扇主循环是 5s 一轮，没有这个节流就会每 5 秒占用一次 AT 通道。
	MODULE_TEMP_INTERVAL="$(cfg_uint module_temp_interval "${H5000M_FAN_MODULE_TEMP_INTERVAL:-30}" 5 3600)"
	MANUAL_PWM="$(cfg_uint manual_pwm 160 0 255)"
	INTERVAL="$(cfg_uint interval 5 2 60)"
	HYSTERESIS="$(cfg_uint hysteresis 2 0 10)"
	DOWN_DELAY="$(cfg_uint down_delay 30 0 300)"
	START_PWM="$(cfg_uint start_pwm 192 80 255)"
	START_BOOST_MS="$(cfg_uint start_boost_ms 700 0 3000)"
	FAIL_PWM="$(cfg_uint fail_pwm 255 192 255)"

	CURVE_SILENT="$(cfg_string curve_silent '20:0,35:0,40:50,55:50,70:60,85:75,95:100')"
	CURVE_BALANCED="$(cfg_string curve_balanced '20:0,35:0,40:50,55:60,70:75,85:90,95:100')"
	CURVE_PERFORMANCE="$(cfg_string curve_performance '20:0,30:60,45:70,60:82,75:92,85:100')"
	CURVE_CUSTOM="$(cfg_string curve_custom '20:0,40:50,55:60,70:75,85:90,95:100')"
	case "$PROFILE" in
		silent) CURVE_DATA="$CURVE_SILENT" ;;
		performance) CURVE_DATA="$CURVE_PERFORMANCE" ;;
		custom) CURVE_DATA="$CURVE_CUSTOM" ;;
		*) CURVE_DATA="$CURVE_BALANCED" ;;
	esac
}

find_pwm() {
	local hwmon pwm name
	for hwmon in /sys/class/hwmon/hwmon*; do
		[ -d "$hwmon" ] || continue
		name="$(cat "$hwmon/name" 2>/dev/null || true)"
		[ "$name" = "pwmfan" ] || continue
		pwm="$hwmon/pwm1"
		[ -e "$pwm" ] && { echo "$pwm"; return 0; }
	done
	for pwm in /sys/class/hwmon/hwmon*/pwm1; do
		[ -e "$pwm" ] && { echo "$pwm"; return 0; }
	done
	return 1
}

find_fan_rpm() {
	local fan
	for fan in /sys/class/hwmon/hwmon*/fan*_input; do
		[ -e "$fan" ] && { echo "$fan"; return 0; }
	done
	return 1
}

find_thermal_zone() {
	local zone policies type fallback
	fallback=""
	for zone in /sys/class/thermal/thermal_zone*; do
		[ -r "$zone/policy" ] && [ -r "$zone/available_policies" ] || continue
		policies="$(cat "$zone/available_policies" 2>/dev/null || true)"
		case " $policies " in *" user_space "*) ;; *) continue ;; esac
		[ -n "$fallback" ] || fallback="$zone"
		type="$(cat "$zone/type" 2>/dev/null || true)"
		case "$(printf '%s' "$type" | tr 'A-Z' 'a-z')" in
			*cpu*|*soc*|*mt798*) echo "$zone"; return 0 ;;
		esac
	done
	[ -n "$fallback" ] && { echo "$fallback"; return 0; }
	return 1
}

take_thermal_control() {
	local zone policy
	zone="$(find_thermal_zone 2>/dev/null || true)"
	[ -n "$zone" ] || {
		CONTROL_ZONE=""
		CONTROL_POLICY=""
		return 0
	}

	# Recover once from releases that changed the complete CPU thermal zone to
	# user_space. The H5000M controller owns PWM output only; the kernel must
	# retain the thermal governor so CPU cooling and critical protection remain
	# active.
	if [ -f "$POLICY_FILE" ]; then
		release_thermal_control
	fi
	policy="$(cat "$zone/policy" 2>/dev/null || true)"
	[ -n "$policy" ] || return 1
	CONTROL_ZONE="$zone"
	CONTROL_POLICY="$policy"
	return 0
}

release_thermal_control() {
	local zone policy available
	[ -f "$POLICY_FILE" ] || return 0
	zone="$(sed -n '1p' "$POLICY_FILE" 2>/dev/null || true)"
	policy="$(sed -n '2p' "$POLICY_FILE" 2>/dev/null || true)"
	if [ -r "$zone/policy" ]; then
		available="$(cat "$zone/available_policies" 2>/dev/null || true)"
		case " $available " in
			*" $policy "*) ;;
			*" step_wise "*) policy="step_wise" ;;
			*) policy="" ;;
		esac
		[ -z "$policy" ] || echo "$policy" > "$zone/policy" 2>/dev/null || true
	fi
	rm -f "$POLICY_FILE"
}

read_temp_c() {
	local value
	value="$(cat "$1" 2>/dev/null || true)"
	case "$value" in ''|*[!0-9-]*) return 1 ;; esac
	if [ "$value" -gt 1000 ] 2>/dev/null || [ "$value" -lt -1000 ] 2>/dev/null; then
		value=$((value / 1000))
	fi
	[ "$value" -ge -40 ] 2>/dev/null && [ "$value" -le 150 ] 2>/dev/null || return 1
	echo "$value"
}

# 12 路传感器名，与 MT5700 Console 前端 Parse.parseCHIPTEMP 的返回**严格一一对应**
# （顺序见鼎桥手册 17.1）。名字对不上，日志里就分不清到底是哪一路在发热。
module_temp_sensor_name() {
	case "$1" in
		0) printf '%s\n' sub3GPA ;;
		1) printf '%s\n' sub6GPA ;;
		2) printf '%s\n' mimoPa ;;
		3) printf '%s\n' tcxo ;;
		4) printf '%s\n' peri1 ;;
		5) printf '%s\n' peri2 ;;
		6) printf '%s\n' ap1 ;;
		7) printf '%s\n' ap2 ;;
		8) printf '%s\n' modem1 ;;
		9) printf '%s\n' modem2 ;;
		10) printf '%s\n' bbp1 ;;
		11) printf '%s\n' bbp2 ;;
		*) printf '%s\n' "ch$1" ;;
	esac
}

# 经 ubus 问 MT5700 Console 的 Rust 后端（at-webserver-rust）要一次 AT^CHIPTEMP?。
#
# ★ 为什么不直接开串口：/dev/ttyUSB1 的唯一持有者是那个 Rust 服务，脚本再去开会把
#   AT 通道抢坏。走 ubus → rpcd ucode → 后端，是**同一条已被认可的链路**。
#
# ★ 成功只看 ubus 回包里的 success（即使带了 data，success 也可能是 false）。
# ★ ^CHIPTEMP? 是只读查询，不在高危命令之列；单位是 0.1℃。
# ★ 65535 是模组报告的无效读数，必须跳过，否则会算出 6553℃ 并把风扇拉满。
#
# 输出 "<摄氏度整数> <最热那一路的下标>"，失败返回 1。
module_temp_via_ubus() {
	local raw nums
	command -v ubus >/dev/null 2>&1 || return 1
	# timeout 兜底：AT 通道被别的操作占住时 ubus 可能挂很久，不能拖住风扇主循环。
	if command -v timeout >/dev/null 2>&1; then
		raw="$(timeout "$MODULE_TEMP_UBUS_TIMEOUT" ubus call mt5700 at '{"cmd":"AT^CHIPTEMP?"}' 2>/dev/null)"
	else
		raw="$(ubus call mt5700 at '{"cmd":"AT^CHIPTEMP?"}' 2>/dev/null)"
	fi
	[ -n "$raw" ] || return 1
	printf '%s' "$raw" | grep -q '"success"[[:space:]]*:[[:space:]]*true' || return 1
	# busybox 的 awk **没有 match()**，所以只能用 sed 剥出数字串。
	# ★ 别加 `tr -d '\r'`：POSIX shell 里单引号的 \r 是两个字面字符，tr 会把所有
	#   反斜杠和字母 r 一起删掉（对数字串无碍，但语义是错的）。而 JSON 里的 \r
	#   本来就是字面文本，不在捕获范围内，无需处理。
	nums="$(printf '%s' "$raw" \
		| sed -n 's/.*CHIPTEMP:[^0-9-]*\([0-9-][0-9,]*\).*/\1/p' | head -n 1)"
	[ -n "$nums" ] || return 1
	printf '%s\n' "$nums" | awk -F, '
		BEGIN { best = ""; idx = -1 }
		{
			for (i = 1; i <= NF; i++) {
				v = $i + 0
				if (v >= 65535 || v <= -1000) continue
				c = v / 10
				if (best == "" || c > best) { best = c; idx = i - 1 }
			}
		}
		END {
			if (idx < 0) exit 1
			printf "%d %d\n", (best < 0 ? best - 0.5 : best + 0.5), idx
		}'
}

# 把读到的温度回写成缓存文件（格式与上游完全一致，别的组件也能直接读）。
module_temp_write_cache() {
	local value="$1" sensor="$2" dir
	dir="${MT5700M_TEMP_CACHE%/*}"
	[ "$dir" != "$MT5700M_TEMP_CACHE" ] || return 0
	mkdir -p "$dir" 2>/dev/null || return 0
	# 先写临时文件再改名：风扇每 5 秒循环一次，直接覆盖会让别处读到写了一半的内容。
	printf 'temperature=%s\ntemperature_sensor=%s\nupdated=%s\n' \
		"$value" "$sensor" "$(date +%s)" > "$dir/.temperature.tmp" 2>/dev/null || return 0
	mv -f "$dir/.temperature.tmp" "$MT5700M_TEMP_CACHE" 2>/dev/null || return 0
	return 0
}

# 读缓存文件。结果放进 MODULE_TEMP_VALUE / MODULE_SENSOR ——
# ★ 不能用 value=$(module_temp_cache_read)：命令替换在子 shell 里跑，
#   这边赋的全局变量回不来，因此必须直接写全局变量。
module_temp_cache_read() {
	MODULE_TEMP_VALUE=""
	[ -r "$MT5700M_TEMP_CACHE" ] || return 1
	MODULE_SENSOR="$(sed -n 's/^temperature_sensor=//p' "$MT5700M_TEMP_CACHE" 2>/dev/null | head -n 1)"
	MODULE_TEMP_VALUE="$(awk -F= '$1 == "temperature" && $2 ~ /^-?[0-9]+([.][0-9]+)?$/ {
		v = $2 + 0
		if (v >= -40 && v <= 150) printf "%d\n", (v < 0 ? v - 0.5 : v + 0.5)
		exit
	}' "$MT5700M_TEMP_CACHE" 2>/dev/null)"
	case "$MODULE_TEMP_VALUE" in ''|*[!0-9-]*) MODULE_TEMP_VALUE=""; return 1 ;; esac
	return 0
}

module_temp_cache_age() {
	local updated now
	updated="$(sed -n 's/^updated=//p' "$MT5700M_TEMP_CACHE" 2>/dev/null | head -n 1)"
	now="$(date +%s)"
	is_uint "$updated" && is_uint "$now" || return 1
	printf '%s\n' $((now - updated))
}

find_module_temp() {
	local value age out idx cached="" cached_sensor=""
	MODULE_SENSOR=""
	MODULE_TEMP_VALUE=""

	[ "$MODULE_TEMP_SOURCE" = "off" ] && return 1

	# ① 本插件自己的缓存（内容只可能来自 ② 的 MT5700 Console 查询，零成本）：
	#    先把值取出来，新鲜度分两档用。
	if [ "$MODULE_TEMP_SOURCE" != "ubus" ]; then
		if module_temp_cache_read; then
			age="$(module_temp_cache_age || true)"
			if is_uint "$age" && [ "$age" -ge 0 ]; then
				if [ "$age" -le "$MODULE_TEMP_INTERVAL" ]; then
					return 0
				elif is_uint "$MT5700M_TEMP_MAX_AGE" && [ "$age" -le "$MT5700M_TEMP_MAX_AGE" ]; then
					# 偏旧：先留着，② 问不到 AT 时还能顶上。
					cached="$MODULE_TEMP_VALUE"
					cached_sensor="$MODULE_SENSOR"
					MODULE_TEMP_VALUE=""
				fi
			fi
		fi
	fi

	# ② ubus → MT5700 Console 的 Rust 后端。查到就回写缓存，下次循环直接读。
	if [ "$MODULE_TEMP_SOURCE" != "cache" ]; then
		out="$(module_temp_via_ubus 2>/dev/null || true)"
		if [ -n "$out" ]; then
			value="${out% *}"
			idx="${out##* }"
			MODULE_SENSOR="$(module_temp_sensor_name "$idx")"
			module_temp_write_cache "$value" "$MODULE_SENSOR"
			MODULE_TEMP_VALUE="$value"
			return 0
		fi
	fi

	# ③ ubus 不可用（服务没起来 / 模组没响应）时退回旧缓存，别让风扇凭空加速。
	if [ -n "$cached" ]; then
		MODULE_SENSOR="$cached_sensor"
		MODULE_TEMP_VALUE="$cached"
		return 0
	fi

	# 没有第 ④ 级。5G 模块数据只有一条来源：经 ubus 问 MT5700 Console。
	# （原先这里会去扫 /tmp/cache_base_info_* / /tmp/cache_*info* —— 那是
	#  **别的模组管理软件**留下的缓存，既不是 Console 的取数链路，本机也不存在。）
	return 1
}

max_sensor() {
	local value="$1" label="$2"
	[ -n "$value" ] || return 0
	if [ -z "${CONTROL_TEMP:-}" ] || [ "$value" -gt "$CONTROL_TEMP" ]; then
		CONTROL_TEMP="$value"
		CONTROL_SENSOR="$label"
	fi
}

read_sensors() {
	local zone type value hwmon name
	CPU_TEMP=""; CPU_LABEL=""; PHY_TEMP=""; PHY_LABEL=""
	WIFI1_TEMP=""; WIFI1_LABEL=""; WIFI2_TEMP=""; WIFI2_LABEL=""
	MODULE_SENSOR=""; MODULE_TEMP_VALUE=""
	# ★ 不能写成 MODULE_TEMP="$(find_module_temp)"：命令替换在子 shell 里跑，
	#   函数里赋的 MODULE_SENSOR / MODULE_TEMP_VALUE 回不到这里。
	find_module_temp 2>/dev/null || MODULE_TEMP_VALUE=""
	MODULE_TEMP="$MODULE_TEMP_VALUE"
	CONTROL_TEMP=""; CONTROL_SENSOR=""

	for zone in /sys/class/thermal/thermal_zone*; do
		[ -e "$zone/temp" ] || continue
		type="$(cat "$zone/type" 2>/dev/null || true)"
		value="$(read_temp_c "$zone/temp" 2>/dev/null || true)"
		[ -n "$value" ] || continue
		case "$(printf '%s' "$type" | tr 'A-Z' 'a-z')" in
			*cpu*|*soc*|*mt798*|*thermal*)
				[ -n "$CPU_TEMP" ] || { CPU_TEMP="$value"; CPU_LABEL="$type"; }
				;;
		esac
	done

	for hwmon in /sys/class/hwmon/hwmon*; do
		[ -d "$hwmon" ] || continue
		name="$(cat "$hwmon/name" 2>/dev/null || true)"
		value="$(read_temp_c "$hwmon/temp1_input" 2>/dev/null || true)"
		[ -n "$value" ] || continue
		case "$(printf '%s' "$name" | tr 'A-Z' 'a-z')" in
			*cpu*|*soc*|*mt798*|*thermal*)
				[ -n "$CPU_TEMP" ] || { CPU_TEMP="$value"; CPU_LABEL="$name"; }
				;;
			*mt799*|*wifi*|*radio*)
				if [ -z "$WIFI1_TEMP" ]; then
					WIFI1_TEMP="$value"; WIFI1_LABEL="$name"
				elif [ -z "$WIFI2_TEMP" ]; then
					WIFI2_TEMP="$value"; WIFI2_LABEL="$name"
				fi
				;;
			*mdio*|*phy*)
				[ -n "$PHY_TEMP" ] || { PHY_TEMP="$value"; PHY_LABEL="$name"; }
				;;
		esac
	done

	max_sensor "$CPU_TEMP" "${CPU_LABEL:-CPU}"
	if [ "$TEMP_SOURCE" = "max" ]; then
		max_sensor "$PHY_TEMP" "${PHY_LABEL:-PHY}"
		max_sensor "$WIFI1_TEMP" "${WIFI1_LABEL:-WiFi 1}"
		max_sensor "$WIFI2_TEMP" "${WIFI2_LABEL:-WiFi 2}"
		max_sensor "$MODULE_TEMP" "5G modem"
	fi
}

cooling_device_path() {
	local dev
	for dev in /sys/class/thermal/cooling_device*; do
		[ -d "$dev" ] || continue
		[ "$(cat "$dev/type" 2>/dev/null || true)" = "pwm-fan" ] && { echo "$dev"; return 0; }
	done
	return 1
}

read_be32() {
	local file="$1" skip="${2:-0}" hex value
	hex="$(dd if="$file" bs=4 skip="$skip" count=1 2>/dev/null | hexdump -v -e '1/1 "%02x"')"
	case "$hex" in
		????????) value="$(printf '%d' "0x$hex" 2>/dev/null || true)" ;;
		*) value="" ;;
	esac
	is_uint "$value" || return 1
	echo "$value"
}

cooling_level_for_state() {
	local state="$1" levels value
	levels="$(readlink -f "$(dirname "$PWM_PATH")/device/of_node/cooling-levels" 2>/dev/null || true)"
	[ -f "$levels" ] || levels="/sys/firmware/devicetree/base/pwm-fan/cooling-levels"
	[ -f "$levels" ] || return 1
	value="$(read_be32 "$levels" "$state" 2>/dev/null || true)"
	is_uint "$value" && [ "$value" -le 255 ] || return 1
	echo "$value"
}

set_thermal_floor() {
	local dev dt fan_phandle map map_phandle map_state trip_ref trip threshold hyst trip_phandle value maps_examined map_found trip_index trip_dir entry
	THERMAL_FLOOR=0
	THERMAL_STATE=0
	THERMAL_MAX_STATE=0
	THERMAL_OWNER="unknown"
	dev="$(cooling_device_path 2>/dev/null || true)"
	[ -n "$dev" ] || return 0
	THERMAL_MAX_STATE="$(cat "$dev/max_state" 2>/dev/null || echo 0)"
	is_uint "$THERMAL_MAX_STATE" || THERMAL_MAX_STATE=0

	dt="$(readlink -f "$(dirname "$PWM_PATH")/device/of_node" 2>/dev/null || true)"
	[ -d "$dt" ] || dt="/sys/firmware/devicetree/base/pwm-fan"
	fan_phandle="$(read_be32 "$dt/phandle" 2>/dev/null || true)"
	maps_examined=0
	map_found=0

	# trip 的「phandle:目录」索引。原实现把 trip 扫描放在 cooling-map 循环内层，
	# 于是每个属于风扇的 map 都要把全部 trip 重扫一遍 —— 真机实测 36 次设备树
	# 读取里有 18 次是这样重复出来的（6 个 trip × 3 个 map）。这里只建一次。
	# 设备树在一次开机内只读且不变，索引不存在过期问题。
	trip_index=""
	for trip in /sys/firmware/devicetree/base/thermal-zones/*/trips/*; do
		[ -f "$trip/phandle" ] && [ -f "$trip/temperature" ] || continue
		trip_phandle="$(read_be32 "$trip/phandle" 0 2>/dev/null || true)"
		is_uint "$trip_phandle" || continue
		trip_index="$trip_index $trip_phandle:$trip"
	done

	# Derive the required state from the kernel's own cooling maps. Direct PWM
	# writes also change cur_state, so cur_state itself is not a safe floor.
	if is_uint "$fan_phandle"; then
		for map in /sys/firmware/devicetree/base/thermal-zones/*/cooling-maps/*; do
			[ -f "$map/cooling-device" ] && [ -f "$map/trip" ] || continue
			map_phandle="$(read_be32 "$map/cooling-device" 0 2>/dev/null || true)"
			is_uint "$map_phandle" || continue
			maps_examined=1
			[ "$map_phandle" = "$fan_phandle" ] || continue
			map_found=1
			map_state="$(read_be32 "$map/cooling-device" 2 2>/dev/null || true)"
			trip_ref="$(read_be32 "$map/trip" 0 2>/dev/null || true)"
			is_uint "$map_state" && is_uint "$trip_ref" || continue
			# 按 phandle 在索引里定位这个 map 引用的 trip（不再重扫全部 trip）
			trip_dir=""
			for entry in $trip_index; do
				case "$entry" in
					"$trip_ref":*) trip_dir="${entry#*:}"; break ;;
				esac
			done
			[ -n "$trip_dir" ] || continue
			threshold="$(read_be32 "$trip_dir/temperature" 0 2>/dev/null || true)"
			hyst="$(read_be32 "$trip_dir/hysteresis" 0 2>/dev/null || echo 0)"
			is_uint "$threshold" || continue
			threshold=$((threshold / 1000)); is_uint "$hyst" || hyst=0; hyst=$((hyst / 1000))
			if [ "$CPU_TEMP" -ge "$((threshold - hyst))" ] && [ "$map_state" -gt "$THERMAL_STATE" ]; then
				THERMAL_STATE="$map_state"
			fi
		done
	fi
	if [ "$maps_examined" -eq 1 ] && [ "$map_found" -eq 0 ]; then
		THERMAL_OWNER="userspace"
		# The old 40 C active map made useful low-speed control impossible. In
		# exclusive mode retain only the high-temperature emergency floors.
		[ -n "$CPU_TEMP" ] || { THERMAL_STATE=3; THERMAL_FLOOR=255; return 0; }
		[ "$CPU_TEMP" -ge 83 ] && THERMAL_STATE=2
		[ "$CPU_TEMP" -ge 113 ] && THERMAL_STATE=3
		if [ "$THERMAL_STATE" -gt 0 ]; then
			value="$(cooling_level_for_state "$THERMAL_STATE" 2>/dev/null || true)"
			if is_uint "$value"; then THERMAL_FLOOR="$value"; else THERMAL_FLOOR=255; fi
		fi
		return 0
	fi
	[ "$map_found" -eq 1 ] && THERMAL_OWNER="shared"
	[ -n "$CPU_TEMP" ] || { THERMAL_FLOOR=255; return 0; }

	# Conservative fallback for old H5000M firmware if DT discovery fails.
	if [ "$THERMAL_STATE" -eq 0 ]; then
		[ "$CPU_TEMP" -ge 38 ] && THERMAL_STATE=1
		[ "$CPU_TEMP" -ge 83 ] && THERMAL_STATE=2
		[ "$CPU_TEMP" -ge 113 ] && THERMAL_STATE=3
	fi
	[ "$THERMAL_STATE" -gt 0 ] || return 0
	value="$(cooling_level_for_state "$THERMAL_STATE" 2>/dev/null || true)"
	if is_uint "$value"; then THERMAL_FLOOR="$value"; else THERMAL_FLOOR=255; fi
}

acquire_lock() {
	local owner
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		echo "$$" > "$LOCK_DIR/pid"
		return 0
	fi
	owner="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
	if ! is_uint "$owner" || ! kill -0 "$owner" 2>/dev/null; then
		rm -rf "$LOCK_DIR" 2>/dev/null
		mkdir "$LOCK_DIR" 2>/dev/null || return 1
		echo "$$" > "$LOCK_DIR/pid"
		return 0
	fi
	return 1
}

release_lock() {
	rm -rf "$LOCK_DIR" 2>/dev/null
}

calc_curve_pwm() {
	local temp="$1" curve="$2" old_ifs point t p prev_t prev_p result
	old_ifs="$IFS"; IFS=','
	for point in $curve; do
		t="${point%%:*}"; p="${point#*:}"
		is_uint "$t" && is_uint "$p" && [ "$t" -le 150 ] && [ "$p" -le 100 ] || { IFS="$old_ifs"; return 1; }
		if [ -n "${prev_t:-}" ] && [ "$t" -le "$prev_t" ]; then IFS="$old_ifs"; return 1; fi
		if [ "$temp" -le "$t" ]; then
			if [ -z "${prev_t:-}" ]; then
				result="$p"
			else
				result=$((prev_p + (temp - prev_t) * (p - prev_p) / (t - prev_t)))
			fi
			IFS="$old_ifs"
			echo $((result * 255 / 100))
			return 0
		fi
		prev_t="$t"; prev_p="$p"
	done
	IFS="$old_ifs"
	[ -n "${prev_p:-}" ] || return 1
	echo $((prev_p * 255 / 100))
}

state_get() {
	local key="$1"
	[ -f "$STATE_FILE" ] || return 0
	sed -n "s/^${key}=//p" "$STATE_FILE" 2>/dev/null | head -n 1
}

write_state() {
	local tmp="${STATE_FILE}.$$"
	{
		echo "updated=$(date +%s)"
		echo "result=$RESULT"
		echo "reason=$REASON"
		echo "requested_pwm=$REQUESTED_PWM"
		echo "target_pwm=$TARGET_PWM"
		echo "applied_pwm=$APPLIED_PWM"
		echo "thermal_floor=$THERMAL_FLOOR"
		echo "thermal_state=$THERMAL_STATE"
		echo "thermal_max_state=$THERMAL_MAX_STATE"
		echo "thermal_owner=$THERMAL_OWNER"
		echo "control_temp=${CONTROL_TEMP:-}"
		echo "control_sensor=${CONTROL_SENSOR:-}"
		echo "down_since=${DOWN_SINCE:-0}"
	} > "$tmp" && mv "$tmp" "$STATE_FILE"
}

apply_once() {
	local current last_pwm candidate now elapsed sleep_s previous_result
	load_config
	PWM_PATH="$(find_pwm 2>/dev/null || true)"
	if [ -z "$PWM_PATH" ]; then
		logger -t "$TAG" "PWM control node not found; unable to apply policy"
		return 1
	fi

	read_sensors
	set_thermal_floor
	REQUESTED_PWM=0; REASON="$MODE"; RESULT="ok"; DOWN_SINCE=0

	if [ "$ENABLED" != "1" ] || [ "$MODE" = "kernel" ]; then
		release_thermal_control
		current="$(cat "$PWM_PATH" 2>/dev/null || true)"
		is_uint "$current" || current=0
		REQUESTED_PWM=0; TARGET_PWM="$current"; APPLIED_PWM="$current"
		REASON="kernel"
		THERMAL_OWNER="kernel"
		write_state
		return 0
	fi

	if ! take_thermal_control; then
		logger -t "$TAG" "unable to inspect kernel thermal policy; cooling policy not changed"
		release_thermal_control
		return 1
	fi
	[ "$THERMAL_OWNER" = "unknown" ] && THERMAL_OWNER="userspace-pwm"

	if [ "$MODE" = "manual" ]; then
		REQUESTED_PWM="$MANUAL_PWM"
		REASON="manual"
	elif [ -z "$CONTROL_TEMP" ]; then
		REQUESTED_PWM="$FAIL_PWM"
		REASON="sensor-failsafe"
		RESULT="failsafe"
	else
		REQUESTED_PWM="$(calc_curve_pwm "$CONTROL_TEMP" "$CURVE_DATA" 2>/dev/null || true)"
		if ! is_uint "$REQUESTED_PWM"; then
			REQUESTED_PWM="$FAIL_PWM"
			REASON="curve-failsafe"
			RESULT="failsafe"
		else
			REASON="auto"
		fi
	fi

	REQUESTED_PWM="$(clamp "$REQUESTED_PWM" 0 255)"
	TARGET_PWM="$REQUESTED_PWM"
	[ "$THERMAL_FLOOR" -gt "$TARGET_PWM" ] && { TARGET_PWM="$THERMAL_FLOOR"; REASON="${REASON}+kernel-floor"; }

	current="$(cat "$PWM_PATH" 2>/dev/null || true)"
	is_uint "$current" || current=0
	last_pwm="$(state_get applied_pwm)"; is_uint "$last_pwm" || last_pwm="$current"
	now="$(date +%s)"

	if [ "$MODE" = "auto" ] && [ "$RESULT" = "ok" ] && [ "$TARGET_PWM" -lt "$last_pwm" ]; then
		candidate="$(calc_curve_pwm "$((CONTROL_TEMP + HYSTERESIS))" "$CURVE_DATA" 2>/dev/null || echo "$TARGET_PWM")"
		is_uint "$candidate" || candidate="$TARGET_PWM"
		[ "$THERMAL_FLOOR" -gt "$candidate" ] && candidate="$THERMAL_FLOOR"
		TARGET_PWM="$candidate"
		DOWN_SINCE="$(state_get down_since)"; is_uint "$DOWN_SINCE" || DOWN_SINCE=0
		[ "$DOWN_SINCE" -gt 0 ] || DOWN_SINCE="$now"
		elapsed=$((now - DOWN_SINCE))
		if [ "$elapsed" -lt "$DOWN_DELAY" ]; then
			TARGET_PWM="$last_pwm"
			REASON="auto-down-delay"
		else
			DOWN_SINCE=0
		fi
	fi

	TARGET_PWM="$(clamp "$TARGET_PWM" 0 255)"
	if [ "$current" -eq 0 ] && [ "$TARGET_PWM" -gt 0 ] && [ "$START_BOOST_MS" -gt 0 ]; then
		candidate="$START_PWM"; [ "$TARGET_PWM" -gt "$candidate" ] && candidate="$TARGET_PWM"
		echo "$candidate" > "$PWM_PATH" 2>/dev/null || return 1
		# BusyBox sleep in official snapshots accepts integer seconds only.
		sleep_s=$(((START_BOOST_MS + 999) / 1000))
		sleep "$sleep_s"
	fi

	if [ "$current" -ne "$TARGET_PWM" ]; then
		if ! echo "$TARGET_PWM" > "$PWM_PATH" 2>/dev/null; then
			logger -t "$TAG" "failed to set PWM target=$TARGET_PWM"
			return 1
		fi
	fi
	APPLIED_PWM="$(cat "$PWM_PATH" 2>/dev/null || true)"
	is_uint "$APPLIED_PWM" || APPLIED_PWM="$TARGET_PWM"
	previous_result="$(state_get result)"
	if [ "$RESULT" != "$previous_result" ]; then
		if [ "$RESULT" = "failsafe" ]; then
			logger -t "$TAG" "failsafe enabled reason=$REASON pwm=$TARGET_PWM"
		elif [ "$previous_result" = "failsafe" ]; then
			logger -t "$TAG" "sensor and curve validation recovered; normal control resumed"
		fi
	fi
	write_state
	return 0
}

print_settings() {
	echo "enabled=$ENABLED"
	echo "mode=$MODE"
	echo "curve=$PROFILE"
	echo "curve_data=$CURVE_DATA"
	echo "temp_source=$TEMP_SOURCE"
	echo "manual_pwm=$MANUAL_PWM"
	echo "interval=$INTERVAL"
	echo "hysteresis=$HYSTERESIS"
	echo "down_delay=$DOWN_DELAY"
	echo "start_pwm=$START_PWM"
	echo "start_boost_ms=$START_BOOST_MS"
}

print_status() {
	local fan updated now age zone policy
	load_config
	PWM_PATH="$(find_pwm 2>/dev/null || true)"
	read_sensors
	THERMAL_FLOOR=0; THERMAL_STATE=0; THERMAL_MAX_STATE=0; THERMAL_OWNER="unknown"
	[ -n "$PWM_PATH" ] && set_thermal_floor
	zone="$(find_thermal_zone 2>/dev/null || true)"
	policy="$([ -n "$zone" ] && cat "$zone/policy" 2>/dev/null || true)"
	if [ "$ENABLED" != "1" ] || [ "$MODE" = "kernel" ]; then
		THERMAL_OWNER="kernel"
	fi
	print_settings
	echo "pwm=${PWM_PATH:-}"
	echo "pwm_value=$([ -n "$PWM_PATH" ] && cat "$PWM_PATH" 2>/dev/null || true)"
	fan="$(find_fan_rpm 2>/dev/null || true)"
	echo "fan=${fan:-}"
	if [ -n "$fan" ]; then
		echo "fan_feedback=1"
		echo "fan_rpm=$(cat "$fan" 2>/dev/null || true)"
	else
		echo "fan_feedback=0"
		echo "fan_rpm="
	fi
	echo "cpu_temp=$CPU_TEMP"; echo "cpu_label=$CPU_LABEL"
	echo "phy_temp=$PHY_TEMP"; echo "phy_label=$PHY_LABEL"
	echo "wifi1_temp=$WIFI1_TEMP"; echo "wifi1_label=$WIFI1_LABEL"
	echo "wifi2_temp=$WIFI2_TEMP"; echo "wifi2_label=$WIFI2_LABEL"
	echo "module_temp=$MODULE_TEMP"; echo "module_label=5G modem"
	# 具体是哪一路最热（sub3GPA/sub6GPA/.../bbp2）。module_label 保持 "5G modem"
	# 不变 —— LuCI 靠它高亮传感器卡片，改名会让高亮失效。
	echo "module_sensor=$MODULE_SENSOR"
	echo "control_temp=$CONTROL_TEMP"; echo "control_sensor=$CONTROL_SENSOR"
	echo "thermal_floor=$THERMAL_FLOOR"
	echo "thermal_state=$THERMAL_STATE"
	echo "thermal_max_state=$THERMAL_MAX_STATE"
	echo "thermal_owner=$THERMAL_OWNER"
	for key in result reason requested_pwm target_pwm applied_pwm; do
		echo "$key=$(state_get "$key")"
	done
	updated="$(state_get updated)"; now="$(date +%s)"
	if is_uint "$updated"; then age=$((now - updated)); else age=""; fi
	echo "state_age=$age"
}

run_daemon() {
	trap 'exit 0' TERM INT
	trap 'release_lock; release_thermal_control' EXIT
	while true; do
		if acquire_lock; then
			apply_once
			release_lock
		fi
		load_config
		sleep "$INTERVAL" & wait $!
	done
}

case "${1:-apply}" in
	apply)
		if acquire_lock; then
			trap 'release_lock' EXIT
			apply_once
		else
			echo "fan control is busy" >&2
			exit 1
		fi
		;;
	status) print_status ;;
	daemon) run_daemon ;;
	release) release_thermal_control ;;
	*) echo "Usage: $0 {apply|status|daemon|release}"; exit 1 ;;
esac
